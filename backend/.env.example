# Copy this file to .env and fill in real values. NEVER commit .env.
# (.env is gitignored; this .example documents every variable the app reads.)

# --- Anthropic (Claude) API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Database (PostgreSQL + pgvector) ---
# The app's runtime connection AND the target for Drizzle migrations
# (`npm run db:migrate`). Staging/prod must append ?sslmode=require.
DATABASE_URL=postgres://postgres:changeme@localhost:5432/odc_poc_dev
# Optional: connection pool size (default 10).
# DATABASE_POOL_MAX=10

# --- Server ---
PORT=3000
# Max request/upload body size in MB (SEC-006). Default 1024 (1 GB) to allow
# large scanned productions. Keep the ingress proxy-body-size in sync.
UPLOAD_MAX_MB=1024
# Reject PDFs with more than this many pages before the heavy OCR pass, with
# guidance to split the file. Default 5000; set to 0 to disable the cap.
MAX_PDF_PAGES=5000
# Comma-separated CORS allowlist (SEC-008). Leave empty for same-origin only.
CORS_ORIGINS=
# Disciplinary-rule AI legal analysis (Rule XI lens, complaint rule-violation
# analysis, Rule 1.15 flags, deficiency-letter drafting). OFF by default — ODC is
# not permitted to use AI for that analysis during testing. Must mirror the
# frontend RULE_ANALYSIS_ENABLED flag in frontend/index.html. See src/config/features.ts.
RULE_ANALYSIS_ENABLED=false

# --- Staff PINs (legacy local login fallback) ---
PIN_CATERINA=0000
PIN_ABESHA=0000
PIN_ROBEL=0000

# --- GPTZero (AI-text detection, with Claude fallback) ---
GPTZERO_API_KEY=your-gptzero-key

# --- Microsoft Entra ID (Azure AD) SSO ---
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=your-entra-client-secret
ENTRA_REDIRECT_URI=http://localhost:3000/auth/callback
ENTRA_ALLOWED_DOMAINS=dcbar.org
