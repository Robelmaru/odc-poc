# Copy this file to .env and fill in real values. NEVER commit .env.
# (.env is gitignored; this .example documents every variable the app reads.)

# --- Anthropic (Claude) API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Database ---
# POC default: local SQLite file. The DC Bar platform standard is
# PostgreSQL + pgvector; the DATABASE_* vars below are staged for that migration.
DATABASE_PATH=./data/odc-poc.db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_NAME=odc_poc_dev

# --- Server ---
PORT=3000
# Max request/upload body size in MB (SEC-006). Default 200.
UPLOAD_MAX_MB=200
# Comma-separated CORS allowlist (SEC-008). Leave empty for same-origin only.
CORS_ORIGINS=

# --- Staff PINs (legacy local login fallback) ---
PIN_CATERINA=0000
PIN_ABESHA=0000
PIN_ROBEL=0000

# --- GPTZero (AI-text detection, with Claude fallback) ---
GPTZERO_API_KEY=your-gptzero-key

# --- Microsoft Entra ID (Azure AD) SSO ---
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=your-entra-client-secret
ENTRA_REDIRECT_URI=http://localhost:3000/auth/callback
ENTRA_ALLOWED_DOMAINS=dcbar.org
